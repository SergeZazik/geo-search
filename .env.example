# Copy to .env and adjust. docker compose reads these values too.

POSTGRES_USER=geo
POSTGRES_PASSWORD=geo
POSTGRES_DB=geo
DB_PORT=5433

# Used when running the API, migrations or ETL on the host (uv run ...).
# Inside docker compose the URL is built from the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://geo:geo@localhost:5433/geo

# Plain-language search (POST /search) needs an OpenAI API key; without one the
# endpoint answers 503 and the rest of the API works as usual.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# Cache of parsed queries. Inside docker compose the API uses its own Redis service.
REDIS_URL=redis://localhost:6380/0
REDIS_PORT=6380

# OpenStreetMap source dump for `make import`.
OSM_SOURCE_URL=https://download.geofabrik.de/europe/ukraine-latest.osm.pbf

# Any PostGIS 16 image. The default is a multi-arch build of the official
# postgis/postgis image, so it runs natively on Apple Silicon.
# POSTGIS_IMAGE=postgis/postgis:16-3.5
