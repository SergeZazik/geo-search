<?xml version="1.0" encoding="UTF-8"?>
<!--
  Synthetic test data. Coordinates are near the center of Dnipro so that
  distances are realistic; the objects are made up.
  Center point used by the tests: lat 48.4650, lon 35.0450.
-->
<osm version="0.6" generator="hand-written">
  <!-- Cafe at the center point, with names in every supported language. -->
  <node id="1" version="1" lat="48.4650" lon="35.0450">
    <tag k="amenity" v="cafe"/>
    <tag k="name" v="Кава Тест"/>
    <tag k="name:uk" v="Кава Тест"/>
    <tag k="name:en" v="Test Coffee"/>
    <tag k="name:ru" v="Кофе Тест"/>
    <tag k="cuisine" v="coffee_shop"/>
  </node>
  <!-- Cafe ~1 km north. -->
  <node id="2" version="1" lat="48.4740" lon="35.0450">
    <tag k="amenity" v="cafe"/>
    <tag k="name" v="Далека кава"/>
  </node>
  <!-- ~300 m east. Tagged as both restaurant and hotel: amenity wins. -->
  <node id="3" version="1" lat="48.4650" lon="35.0491">
    <tag k="amenity" v="restaurant"/>
    <tag k="tourism" v="hotel"/>
    <tag k="name" v="Готель з рестораном"/>
  </node>
  <!-- Street furniture: not imported. -->
  <node id="4" version="1" lat="48.4651" lon="35.0451">
    <tag k="amenity" v="bench"/>
  </node>
  <!-- Multi-valued tag: kind is the first value. -->
  <node id="5" version="1" lat="48.4660" lon="35.0440">
    <tag k="shop" v="supermarket;convenience"/>
    <tag k="name" v="Супермаркет"/>
  </node>
  <!-- No POI tags: not imported. -->
  <node id="6" version="1" lat="48.4655" lon="35.0455">
    <tag k="highway" v="bus_stop"/>
    <tag k="name" v="Зупинка"/>
  </node>
  <!-- Far away, in Kyiv. -->
  <node id="8" version="1" lat="50.4501" lon="30.5234">
    <tag k="amenity" v="cafe"/>
    <tag k="name" v="Київська кава"/>
  </node>

  <!-- Park: closed way, a 200 x 200 m square (~4 ha). -->
  <node id="101" version="1" lat="48.4600" lon="35.0400"/>
  <node id="102" version="1" lat="48.4600" lon="35.04271"/>
  <node id="103" version="1" lat="48.4618" lon="35.04271"/>
  <node id="104" version="1" lat="48.4618" lon="35.0400"/>
  <way id="100" version="1">
    <nd ref="101"/><nd ref="102"/><nd ref="103"/><nd ref="104"/><nd ref="101"/>
    <tag k="leisure" v="park"/>
    <tag k="name" v="Тестовий парк"/>
    <tag k="name:en" v="Test Park"/>
  </way>

  <!-- Running track: open way, stored as a line. -->
  <node id="201" version="1" lat="48.4600" lon="35.0520"/>
  <node id="202" version="1" lat="48.4605" lon="35.0530"/>
  <way id="200" version="1">
    <nd ref="201"/><nd ref="202"/>
    <tag k="leisure" v="track"/>
  </way>

  <!-- Garden: multipolygon relation with an untagged outer way. -->
  <node id="311" version="1" lat="48.4700" lon="35.0500"/>
  <node id="312" version="1" lat="48.4700" lon="35.05135"/>
  <node id="313" version="1" lat="48.4709" lon="35.05135"/>
  <node id="314" version="1" lat="48.4709" lon="35.0500"/>
  <way id="301" version="1">
    <nd ref="311"/><nd ref="312"/><nd ref="313"/><nd ref="314"/><nd ref="311"/>
  </way>
  <relation id="300" version="1">
    <member type="way" ref="301" role="outer"/>
    <tag k="type" v="multipolygon"/>
    <tag k="leisure" v="garden"/>
    <tag k="name" v="Сад"/>
  </relation>

  <!-- City boundary (admin_level 8, place=city): imported. -->
  <node id="411" version="1" lat="48.4500" lon="35.0300"/>
  <node id="412" version="1" lat="48.4500" lon="35.0600"/>
  <node id="413" version="1" lat="48.4800" lon="35.0600"/>
  <node id="414" version="1" lat="48.4800" lon="35.0300"/>
  <way id="401" version="1">
    <nd ref="411"/><nd ref="412"/><nd ref="413"/><nd ref="414"/><nd ref="411"/>
  </way>
  <relation id="400" version="1">
    <member type="way" ref="401" role="outer"/>
    <tag k="type" v="boundary"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="8"/>
    <tag k="place" v="city"/>
    <tag k="name" v="Тестоград"/>
    <tag k="name:uk" v="Тестоград"/>
    <tag k="name:en" v="Testograd"/>
  </relation>

  <!-- City district (admin_level 9): not imported. -->
  <node id="511" version="1" lat="48.4550" lon="35.0350"/>
  <node id="512" version="1" lat="48.4550" lon="35.0380"/>
  <node id="513" version="1" lat="48.4580" lon="35.0380"/>
  <node id="514" version="1" lat="48.4580" lon="35.0350"/>
  <way id="501" version="1">
    <nd ref="511"/><nd ref="512"/><nd ref="513"/><nd ref="514"/><nd ref="511"/>
  </way>
  <relation id="500" version="1">
    <member type="way" ref="501" role="outer"/>
    <tag k="type" v="boundary"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="9"/>
    <tag k="name" v="Тестовий район"/>
  </relation>

  <!--
    A street split into two ways with the same name, as streets are in OSM.
    No name:ru, so a Russian query finds it only by fuzzy matching.
    Way 600 runs east along lat 48.4670, way 610 continues to the north-east.
  -->
  <node id="601" version="1" lat="48.4670" lon="35.0380"/>
  <node id="602" version="1" lat="48.4670" lon="35.0460"/>
  <node id="611" version="1" lat="48.4680" lon="35.0540"/>
  <way id="600" version="1">
    <nd ref="601"/><nd ref="602"/>
    <tag k="highway" v="primary"/>
    <tag k="name" v="Січеславська набережна"/>
    <tag k="name:uk" v="Січеславська набережна"/>
    <tag k="name:en" v="Sicheslavska Embankment"/>
  </way>
  <way id="610" version="1">
    <nd ref="602"/><nd ref="611"/>
    <tag k="highway" v="primary"/>
    <tag k="name" v="Січеславська набережна"/>
    <tag k="name:uk" v="Січеславська набережна"/>
    <tag k="name:en" v="Sicheslavska Embankment"/>
  </way>

  <!-- A street with the same name in Kyiv, ~55 m north of the Kyiv cafe. -->
  <node id="621" version="1" lat="50.4506" lon="30.5200"/>
  <node id="622" version="1" lat="50.4506" lon="30.5270"/>
  <way id="620" version="1">
    <nd ref="621"/><nd ref="622"/>
    <tag k="highway" v="secondary"/>
    <tag k="name" v="Січеславська набережна"/>
  </way>

  <!-- Unnamed road: not imported. -->
  <node id="701" version="1" lat="48.4630" lon="35.0400"/>
  <node id="702" version="1" lat="48.4630" lon="35.0500"/>
  <way id="700" version="1">
    <nd ref="701"/><nd ref="702"/>
    <tag k="highway" v="residential"/>
  </way>

  <!-- Named footway: not a street, not imported. -->
  <node id="801" version="1" lat="48.4640" lon="35.0400"/>
  <node id="802" version="1" lat="48.4640" lon="35.0500"/>
  <way id="800" version="1">
    <nd ref="801"/><nd ref="802"/>
    <tag k="highway" v="footway"/>
    <tag k="name" v="Алея"/>
  </way>

  <!--
    City limits that are no administrative boundary, only a multipolygon with
    place=city, as Dnipro and Odesa are mapped: imported. Covers the Kyiv cafe
    (node/8) and the Kyiv street (way 620).
  -->
  <node id="911" version="1" lat="50.4400" lon="30.5100"/>
  <node id="912" version="1" lat="50.4400" lon="30.5400"/>
  <node id="913" version="1" lat="50.4600" lon="30.5400"/>
  <node id="914" version="1" lat="50.4600" lon="30.5100"/>
  <way id="901" version="1">
    <nd ref="911"/><nd ref="912"/><nd ref="913"/><nd ref="914"/><nd ref="911"/>
  </way>

  <!-- A small village named like the city, mapped as a closed way: imported. -->
  <node id="951" version="1" lat="48.3000" lon="35.3000"/>
  <node id="952" version="1" lat="48.3000" lon="35.3020"/>
  <node id="953" version="1" lat="48.3010" lon="35.3020"/>
  <node id="954" version="1" lat="48.3010" lon="35.3000"/>
  <way id="950" version="1">
    <nd ref="951"/><nd ref="952"/><nd ref="953"/><nd ref="954"/><nd ref="951"/>
    <tag k="place" v="village"/>
    <tag k="name" v="Тестоград"/>
  </way>

  <!-- The Kyiv city limits, built from way 901 above. -->
  <relation id="900" version="1">
    <member type="way" ref="901" role="outer"/>
    <tag k="type" v="multipolygon"/>
    <tag k="place" v="city"/>
    <tag k="name" v="Київ"/>
    <tag k="name:uk" v="Київ"/>
    <tag k="name:en" v="Kyiv"/>
    <tag k="name:ru" v="Киев"/>
  </relation>
</osm>
